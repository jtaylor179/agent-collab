# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# collab bus runtime data (created wherever COLLAB_ROOT points; default ./.collab)
.collab/
.collab2/

# watcher/demo runtime output (recreated by the run scripts). Unanchored so it
# also catches the copies dropped at the repo root, not just under demo/.
.run/
.run-watcher/
demo/_probe/

# nohup/watcher launch scratch log
activity.log

# SQLite runtime databases
*.db
*.db-shm
*.db-wal
*.db-journal

# OS cruft
.DS_Store
